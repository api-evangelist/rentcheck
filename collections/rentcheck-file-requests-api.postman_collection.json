          "name": "Get a file request by ID",
          "request": {
            "name": "Get a file request by ID",
            "description": {
              "content": "Returns a single file request. Used by the apps to poll for the completion of long-running\nPDF / ZIP report generation jobs and to retrieve the resulting download URL.\n",
              "type": "text/plain"
